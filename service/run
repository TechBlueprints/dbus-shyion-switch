#!/bin/sh
echo "*** starting dbus-shyion-switch ***"
exec 2>&1
. /etc/profile.d/profile.sh

# Brief delay on restart to allow D-Bus name release from previous instance
sleep 3

echo "Starting Shyion relay manager..."
cd /data/apps/dbus-shyion-switch
exec softlimit -d 150000000 -s 2000000 -a 150000000 python3 -u dbus-shyion-switch.py
